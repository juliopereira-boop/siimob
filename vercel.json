{
  "rewrites": [
    { "source": "/",                  "destination": "/index.html" },
    { "source": "/:slug/login",       "destination": "/login.html" },
    { "source": "/:slug/repasse",     "destination": "/repasse.html" },
    { "source": "/:slug/registro",    "destination": "/registro.html" },
    { "source": "/:slug/dashboard",    "destination": "/repasse.html" },
    { "source": "/:slug/admin",        "destination": "/tenant-admin.html" },
    { "source": "/:slug/workflow",     "destination": "/workflow.html" },
    { "source": "/:slug/configuracoes","destination": "/repasse.html" },
    { "source": "/superadmin",         "destination": "/superadmin.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",         "value": "DENY" },
        { "key": "X-XSS-Protection",        "value": "1; mode=block" },
        { "key": "Referrer-Policy",         "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
